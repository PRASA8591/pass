rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow create: if isValidUser(request.resource.data, userId);
      allow read: if true;
      allow update: if isValidUser(request.resource.data, userId);
      allow delete: if true;
    }

    match /users/{userId}/entries/{entryId} {
      allow create: if request.resource.data.userId == userId && validEntry(request.resource.data);
      allow read: if true;
      allow update: if request.resource.data.userId == userId && validEntry(request.resource.data);
      allow delete: if true;
    }

    function isValidUser(data, userId) {
      return data.username == userId
        && data.passwordHash is string
        && data.passwordSalt is string
        && data.otpSecret is string
        && data.otpEnabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validEntry(data) {
      return data.keys().hasOnly([
        'userId', 'label', 'username', 'password', 'remark',
        'createdAt', 'updatedAt', 'lastViewedAt', 'version'
      ])
        && data.userId is string && data.userId.size() > 0
        && data.label is string && data.label.size() > 0 && data.label.size() <= 2048
        && data.username is string && data.username.size() > 0 && data.username.size() <= 2048
        && data.password is string && data.password.size() > 0 && data.password.size() <= 4096
        && data.remark is string && data.remark.size() <= 4096
        && data.version is number
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }
  }
}